DATABASE_URL=postgres://postgres:postgres@localhost:5432/status

API_HOST=0.0.0.0
API_PORT=3001
API_BASE_PATH=/api

HOST=0.0.0.0
PORT=3000

# server-side calls go to 127.0.0.1:$API_PORT$API_BASE_PATH, falling back to PUBLIC_API_URL
# set this to pin them somewhere else (and to skip the fallback)
# API_INTERNAL_URL=http://api:3001/api

PUBLIC_TIMEZONE=UTC

# browser-facing api url (used for sse and the docs page), must be reachable from the client
PUBLIC_API_URL=http://localhost:3001/api
